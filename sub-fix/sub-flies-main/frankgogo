proxy-groups:
  - name: "🚀 节点选择"
    type: select
    proxies:
      - "♻️ 自动选择"
      - "🔯 故障转移"
      - "香港 CF"
      - "台湾"
      - "新加坡"
      - "新加坡 TUIC"
      - "新加坡 Hysteria2"
      - "洛杉矶 DC02"
      - "洛杉矶 DC02 TUIC"
      - "洛杉矶 DC02 HY2"
      - "洛杉矶 NAT"
      - "洛杉矶 NAT TUIC"
      - "洛杉矶 NAT HY2"
      - "DIRECT"

  - name: "♻️ 自动选择"
    type: url-test
    proxies:
      - "香港 CF"
      - "台湾"
      - "新加坡"
      - "新加坡 TUIC"
      - "新加坡 Hysteria2"
      - "洛杉矶 DC02"
      - "洛杉矶 DC02 TUIC"
      - "洛杉矶 DC02 HY2"
      - "洛杉矶 NAT"
      - "洛杉矶 NAT TUIC"
      - "洛杉矶 NAT HY2"
    url: "http://www.gstatic.com/generate_204"
    interval: 300
    tolerance: 50

  - name: "🔯 故障转移"
    type: fallback
    proxies:
      - "香港 CF"
      - "新加坡"
      - "洛杉矶 DC02"
      - "洛杉矶 NAT"
      - "台湾"
    url: "http://www.gstatic.com/generate_204"
    interval: 300

  - name: "🎯 全球直连"
    type: select
    proxies:
      - "DIRECT"
      - "🚀 节点选择"

  - name: "🛑 全球拦截"
    type: select
    proxies:
      - "REJECT"
      - "DIRECT"

rules:
  - GEOIP,CN,🎯 全球直连
  - GEOIP,LAN,🎯 全球直连
  - DOMAIN-SUFFIX,cn,🎯 全球直连
  - MATCH,🚀 节点选择
