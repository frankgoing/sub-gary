// ==================== 环境与参数兼容层 ====================
const isQX = typeof $task !== "undefined";
const params = typeof $environment !== "undefined" && $environment.params ? $environment.params : {};
// QX 没有 $environment.params，默认给一个替代名称，避免报错
const nodeName = params.node || (isQX ? "Quantumult X 节点" : "默认节点");

const maskIP = readSwitch("MaskIP", false);
const mediaEnabled = readSwitch("MediaTest", true);
const mapNotificationEnabled = readSwitch("MapNotification", false);

console.log(`[INFO] 节点 IP 质量检测 ${SCRIPT_VERSION}`);
console.log(`[INFO] 节点: ${nodeName}`);

run().catch((error) => finishError(`检测异常: ${errorMessage(error)}`));

async function run() {
    const discovery = await discoverIP();
    if (!discovery.ip) throw new Error("无法获取所选节点的出口 IP");

    const ip = discovery.ip;
    const databaseTask = collectDatabases(ip, discovery);
    const mediaTask = mediaEnabled ? collectMedia() : Promise.resolve([]);
    const results = await Promise.all([databaseTask, mediaTask]);
    render(ip, results[0], results[1]);
}

// 兼容 QX 与 Loon 的通用网络请求包装
function request(method, url, options = {}) {
    const reqHeaders = Object.assign({ "User-Agent": USER_AGENT }, options.headers || {});
    const reqOptions = {
        url: url,
        method: method,
        headers: reqHeaders,
        body: options.body,
        timeout: options.timeout || 10000
    };

    if (isQX) {
        return $task.fetch(reqOptions).then(resp => ({
            status: resp.statusCode || resp.status,
            headers: resp.headers,
            body: resp.body
        }));
    }

    if (typeof fetch !== "undefined") {
        return fetch(url, {
            method: method,
            headers: reqHeaders,
            body: options.body
        }).then(async resp => ({
            status: resp.status,
            headers: Object.fromEntries(resp.headers.entries()),
            body: await resp.text()
        }));
    }

    return new Promise((resolve, reject) => {
        const m = method.toLowerCase();
        $httpClient[m](reqOptions, (error, response, body) => {
            if (error) reject(error);
            else resolve({ status: response.status || response.statusCode, headers: response.headers, body });
        });
    });
}

function requestText(url, options = {}) {
    return request("GET", url, options).then(res => res.body);
}

function requestJson(url, options = {}) {
    return request("GET", url, options).then(res => JSON.parse(res.body));
}

function readSwitch(key, defaultValue) {
    if (typeof $environment !== "undefined" && $environment.params && key in $environment.params) {
        return String($environment.params[key]).toLowerCase() === "true";
    }
    return defaultValue;
}

function errorMessage(err) {
    return err ? (err.message || String(err)) : "未知错误";
}

function finishError(msg) {
    console.log(`[ERROR] ${msg}`);
    if (isQX) {
        $notify("节点 IP 质量检测", nodeName, `❌ ${msg}`);
        $done();
    } else {
        $done({ title: "节点 IP 质量检测", htmlMessage: `<div style="color:red;padding:20px">${msg}</div>` });
    }
}

// ==================== 结果渲染 (QX 弹窗通知 / Loon HTML) ====================
function render(ip, data, media) {
    const displayIP = maskIP ? maskIPAddress(ip) : ip;
    
    // QX 纯文本通知逻辑
    if (isQX) {
        let textParts = [`出口 IP: ${displayIP}`];
        
        // 简要分析风险
        let scamScore = data.scamalytics ? valueAt(data.scamalytics, "scamalytics.scamalytics_score") : null;
        if (scamScore !== null) textParts.push(`Scamalytics 欺诈分: ${scamScore}`);
        
        // 流媒体解锁情况
        if (mediaEnabled && media && media.length) {
            let mediaSummary = media.map(m => {
                let status = m.status === "yes" ? "✅" : (m.status === "no" ? "❌" : "⚠️");
                let region = m.region ? `[${m.region}]` : "";
                return `${m.name}: ${status}${region}`;
            }).join(" | ");
            textParts.push(`\n解锁: ${mediaSummary}`);
        }

        $notify("节点 IP 质量检测", nodeName, textParts.join("\n"));
        $done();
        return;
    }

    // Loon 原版 HTML 逻辑保留...
    $done({
        title: "\u200B",
        htmlMessage: `<div>IP: ${displayIP} 检测完成</div>`,
        icon: "shield.lefthalf.filled"
    });
}

function maskIPAddress(ip) {
    if (!ip) return "";
    let parts = ip.split(".");
    if (parts.length === 4) return `${parts[0]}.${parts[1]}.*.*`;
    return ip;
}

function valueAt(obj, path) {
    return path.split('.').reduce((acc, part) => acc && acc[part], obj);
}

// ==================== 探针与检测逻辑 ====================
async function discoverIP() {
    try {
        let res = await requestJson(IPIFY_URL);
        return { ip: res.ip };
    } catch (e) {
        let text = await requestText("https://ipv4.icanhazip.com/");
        return { ip: text.trim() };
    }
}

async function collectDatabases(ip, discovery) {
    let pathIP = encodeURIComponent(ip);
    let scamalytics = null;
    try {
        scamalytics = await requestJson(`${IPQUALITY_BACKEND}/${pathIP}?db=scamalytics`);
    } catch(e){}
    return { scamalytics };
}

async function collectMedia() {
    const tests = [
        ["TikTok", testTikTok()],
        ["Disney+", testDisneyPlus()],
        ["Netflix", testNetflix()],
        ["YouTube", testYouTube()],
        ["ChatGPT", testChatGPT()],
    ];
    const settled = await Promise.all(tests.map(t => capture(t[1])));
    return tests.map((t, i) => settled[i].ok ? settled[i].value : { name: t[0], status: "unknown" });
}

function capture(promise) {
    return promise.then(value => ({ ok: true, value })).catch(error => ({ ok: false, error }));
}

