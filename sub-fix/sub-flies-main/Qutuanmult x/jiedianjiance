 * @Updated: 2026-07-25
 *
 * 用法（QX 脚本参数示例，写在 [task_local] / rewrite_local 对应行的 argument 里）：
 *   node=香港01&MaskIP=false&MediaTest=true
 *
 * QX 与 Loon 的关键差异（本版本已处理）：
 *   1. QX 没有 $environment，脚本参数走 $argument（querystring 形式的字符串）
 *   2. 网络请求统一用 $task.fetch，不使用 fetch() / $httpClient
 *   3. 结果展示用 $notify(title, subtitle, body)，QX 不支持 htmlMessage
 */

const SCRIPT_VERSION = "2026-07-25.qx-only";
const IPPURE_URL = "https://my.ippure.com/v1/info";
const IPIFY_URL = "https://api4.ipify.org?format=json";
const IPAPI_URL = "https://api.ipapi.is/";
const IPAPI_COM_URL = "http://ip-api.com/json/";
const IPQUALITY_BACKEND = "https://ipinfo.check.place";
const USER_AGENT = "Mozilla/5.0 (iPhone; CPU iPhone OS 18_0 like Mac OS X) AppleWebKit/605.1.15 Version/18.0 Mobile/15E148 Safari/604.1";
const DISNEY_CLIENT_TOKEN = "ZGlzbmV5JmJyb3dzZXImMS4wLjA.Cu56AgSfBTDag5NiRA81oLHkDZfu5L3CKadnefEAY84";

// ==================== 参数解析（QX 用 $argument 而非 $environment.params） ====================
const params = parseArgument(typeof $argument !== "undefined" ? $argument : "");
const nodeName = params.node || "Quantumult X 节点";
const maskIP = readSwitch(params, "MaskIP", false);
const mediaEnabled = readSwitch(params, "MediaTest", true);

console.log(`[INFO] 节点 IP 质量检测 ${SCRIPT_VERSION}`);
console.log(`[INFO] 节点: ${nodeName}`);

run().catch((error) => finishError(`检测异常: ${errorMessage(error)}`));

async function run() {
    const discovery = await discoverIP();
    if (!discovery.ip) throw new Error("无法获取所选节点的出口 IP");

    const ip = discovery.ip;
    const databaseTask = collectDatabases(ip, discovery);
    const mediaTask = mediaEnabled ? collectMedia() : Promise.resolve([]);
    const results = await Promise.all([databaseTask, mediaTask]);
    render(ip, results[0], results[1]);
}

// ==================== $argument 解析 ====================
function parseArgument(raw) {
    const result = {};
    if (!raw) return result;
    String(raw)
        .split("&")
        .filter(Boolean)
        .forEach((pair) => {
            const idx = pair.indexOf("=");
            if (idx === -1) return;
            const key = decodeURIComponent(pair.slice(0, idx));
            const value = decodeURIComponent(pair.slice(idx + 1));
            result[key] = value;
        });
    return result;
}

function readSwitch(params, key, defaultValue) {
    if (key in params) return String(params[key]).toLowerCase() === "true";
    return defaultValue;
}

// ==================== QX 网络请求封装 ====================
function request(method, url, options = {}) {
    const reqHeaders = Object.assign({ "User-Agent": USER_AGENT }, options.headers || {});
    const reqOptions = {
        url: url,
        method: method,
        headers: reqHeaders,
        body: options.body,
        timeout: options.timeout || 10000
    };
    return $task.fetch(reqOptions).then((resp) => ({
        status: resp.statusCode || resp.status,
        headers: resp.headers,
        body: resp.body
    }));
}

function requestText(url, options = {}) {
    return request("GET", url, options).then((res) => res.body);
}

function requestJson(url, options = {}) {
    return request("GET", url, options).then((res) => JSON.parse(res.body));
}

function errorMessage(err) {
    return err ? (err.message || String(err)) : "未知错误";
}

function finishError(msg) {
    console.log(`[ERROR] ${msg}`);
    $notify("节点 IP 质量检测", nodeName, `❌ ${msg}`);
    $done();
}

// ==================== 结果渲染（QX 纯文本通知） ====================
function render(ip, data, media) {
    const displayIP = maskIP ? maskIPAddress(ip) : ip;
    let textParts = [`出口 IP: ${displayIP}`];

    // 欺诈分 / 风险评分
    const scamScore = data.scamalytics ? valueAt(data.scamalytics, "scamalytics.scamalytics_score") : null;
    if (scamScore !== null && scamScore !== undefined) {
        textParts.push(`Scamalytics 欺诈分: ${scamScore}`);
    }

    // 流媒体解锁情况
    if (mediaEnabled && media && media.length) {
        const mediaSummary = media
            .map((m) => {
                const status = m.status === "yes" ? "✅" : m.status === "no" ? "❌" : "⚠️";
                const region = m.region ? `[${m.region}]` : "";
                return `${m.name}: ${status}${region}`;
            })
            .join(" | ");
        textParts.push(`解锁: ${mediaSummary}`);
    }

    $notify("节点 IP 质量检测", nodeName, textParts.join("\n"));
    $done();
}

function maskIPAddress(ip) {
    if (!ip) return "";
    const parts = ip.split(".");
    if (parts.length === 4) return `${parts[0]}.${parts[1]}.*.*`;
    return ip;
}

function valueAt(obj, path) {
    return path.split(".").reduce((acc, part) => acc && acc[part], obj);
}

// ==================== 探针与检测逻辑 ====================
async function discoverIP() {
    try {
        const res = await requestJson(IPIFY_URL);
        return { ip: res.ip };
    } catch (e) {
        const text = await requestText("https://ipv4.icanhazip.com/");
        return { ip: text.trim() };
    }
}

async function collectDatabases(ip) {
    const pathIP = encodeURIComponent(ip);
    let scamalytics = null;
    try {
        scamalytics = await requestJson(`${IPQUALITY_BACKEND}/${pathIP}?db=scamalytics`);
    } catch (e) {
        console.log(`[WARN] Scamalytics 查询失败: ${errorMessage(e)}`);
    }
    return { scamalytics };
}

async function collectMedia() {
    const tests = [
        ["TikTok", testTikTok()],
        ["Disney+", testDisneyPlus()],
        ["Netflix", testNetflix()],
        ["YouTube", testYouTube()],
        ["ChatGPT", testChatGPT()]
    ];
    const settled = await Promise.all(tests.map((t) => capture(t[1])));
    return tests.map((t, i) => (settled[i].ok ? settled[i].value : { name: t[0], status: "unknown" }));
}

function capture(promise) {
    return promise.then((value) => ({ ok: true, value })).catch((error) => ({ ok: false, error }));
}

async function testTikTok() {
    const res = await request("GET", "https://www.tiktok.com/");
    return { name: "TikTok", status: res.status === 200 ? "yes" : "no" };
}

