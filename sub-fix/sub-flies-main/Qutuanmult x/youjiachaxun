/**
 * 油价查询 · 甘肃 + 宁夏回族自治区
 * 多 Key 自动failover，结果以弹窗（htmlMessage）方式展示，而非系统通知
 *
 * QuantumultX 用户：复制到本地脚本即可，如需改省份用 $argument 传入，
 * 多个省份用英文逗号分隔，例如 $argument=甘肃,宁夏回族自治区
 * 省份名不能含"省"字（自治区/直辖市名称按官方全称填写）
 */

let provArg = typeof $argument !== "undefined" && $argument ? String($argument) : "";
const provinces = (provArg ? provArg.split(",") : ["甘肃", "宁夏", "陕西"])
  .map((item) => item.trim())
  .filter(Boolean);

const API_KEYS = [
  "231de491563c35731436829ac52aad43",
  "a2bc7a0e01be908881ff752677cf94b7",
  "1bcc67c0114bc39a8818c8be12c2c9ac",
  "3c5ee42145c852de4147264f25b858dc",
  "d718b0f7c2b6d71cb3a9814e90bf847f",
];

if (typeof $httpClient === "undefined" && typeof $task === "undefined") {
  console.log("Unsupported execution environment!");
  $done();
} else {
  run().catch((error) => {
    console.log(`执行异常: ${errorMessage(error)}`);
    $done({ title: "油价查询", content: `执行异常: ${errorMessage(error)}` });
  });
}

async function run() {
  const results = await Promise.all(provinces.map((prov) => fetchProvince(prov)));
  render(results);
}

async function fetchProvince(prov) {
  const encodedProv = encodeURIComponent(prov);
  let lastError = "";
  for (let i = 0; i < API_KEYS.length; i += 1) {
    const url = `https://apis.tianapi.com/oilprice/index?key=${API_KEYS[i]}&prov=${encodedProv}`;
    try {
      const body = await request(url);
      const obj = JSON.parse(body);
      console.log(obj);
      if (obj.code === 200 && obj.result) {
        return { prov, ok: true, data: obj.result };
      }
      lastError = obj.msg || `code ${obj.code}`;
      console.log(`[WARN] ${prov} 第 ${i + 1} 个 key 返回失败: ${lastError}`);
    } catch (error) {
      lastError = errorMessage(error);
      console.log(`[WARN] ${prov} 第 ${i + 1} 个 key 请求失败: ${lastError}`);
    }
  }
  return { prov, ok: false, error: lastError || "全部 key 均请求失败" };
}

function request(url) {
  return new Promise((resolve, reject) => {
    if (typeof $httpClient !== "undefined") {
      $httpClient.get({ url }, (error, response, data) => {
        if (error) reject(new Error(error));
        else resolve(data);
      });
    } else if (typeof $task !== "undefined") {
      $task.fetch({ url }).then(
        (response) => resolve(response.body),
        (error) => reject(new Error(errorMessage(error && error.error ? error.error : error)))
      );
    } else {
      reject(new Error("Unsupported execution environment"));
    }
  });
}

const FUEL_META = [
  ["92号汽油", "🟢", "p92"],
  ["95号汽油", "🟡", "p95"],
  ["98号汽油", "🔴", "p98"],
  ["0号柴油", "⚫", "p0"],
];

function render(results) {
  const okResults = results.filter((result) => result.ok);
  const displayTime = okResults.length ? String(okResults[0].data.time || "") : "";

  const html = [
    '<div style="font-family:-apple-system,BlinkMacSystemFont;font-size:14px;line-height:1.5;text-align:left;overflow-wrap:anywhere">',
    '<div style="font-size:18px;line-height:18px">&nbsp;</div>',
    '<div style="font-size:20px;font-weight:700;line-height:1.25;margin-bottom:16px">油价查询</div>',
    displayTime
      ? `<div style="color:#8e8e93;font-size:11px;margin-bottom:10px">更新时间 · ${escapeHtml(displayTime)}</div>`
      : "",
    summaryCard(okResults),
    results.map((result) => renderProvince(result)).join(""),
    '<div style="font-size:9px;line-height:9px">&nbsp;</div>',
    '<div style="color:#8e8e93;font-size:10px;line-height:1.45">数据来自天行数据 oilprice 接口，多 Key 自动切换重试；各省数据独立请求，互不影响。</div>',
    '<div style="font-size:14px;line-height:14px">&nbsp;</div>',
    "</div>",
  ].join("");

  $done({
    title: "\u200B",
    htmlMessage: html,
  });
}

function summaryCard(okResults) {
  if (!okResults.length) return "";
  const lines = okResults
    .filter((result) => result.data.p92 !== undefined && result.data.p92 !== null && result.data.p92 !== "")
    .map((result) => {
      return '<div style="margin-bottom:6px;line-height:1.2">'
        + `<span style="font-size:24px;font-weight:800;letter-spacing:0.2px">¥${escapeHtml(result.data.p92)}</span>`
        + `<span style="color:#8e8e93;font-size:12px;font-weight:600">&nbsp;&nbsp;${escapeHtml(result.data.prov || result.prov)} · 92号汽油</span>`
        + "</div>";
    })
    .join("");
  return lines ? `<div style="margin-bottom:16px">${lines}</div>` : "";
}

function renderProvince(result) {
  if (!result.ok) {
    return section(`📍 ${result.prov}`, mutedLine(`查询失败：${escapeHtml(result.error)}`));
  }
  const data = result.data;
  const body = FUEL_META
    .filter(([, , key]) => data[key] !== undefined && data[key] !== null && data[key] !== "")
    .map(([label, icon, key]) => priceLine(icon, label, `¥${data[key]}`))
    .join("");
  return section(`📍 ${data.prov || result.prov}`, body);
}

function section(title, content) {
  return '<div style="font-size:8px;line-height:8px">&nbsp;</div>'
    + '<div>'
    + `<div style="color:#0A84FF;font-weight:700;font-size:15px;margin-bottom:9px">▌${escapeHtml(title)}</div>`
    + `${content}</div>`;
}

function priceLine(icon, label, value) {
  return '<table style="width:100%;table-layout:fixed;border-collapse:collapse;margin-bottom:11px"><tr>'
    + `<td style="font-size:15px;width:24px;padding:0">${icon}</td>`
    + `<td style="font-weight:600;color:#3a3a3c;white-space:nowrap;width:80px;padding:0 8px 0 0">${escapeHtml(label)}</td>`
    + `<td style="font-weight:800;color:#000000;padding:0">${escapeHtml(value)}</td>`
    + '</tr></table>';
}

function infoLine(label, value) {
  return '<div style="margin-bottom:8px;line-height:1.4">'
    + `<span style="color:#8e8e93;font-size:12px">${escapeHtml(label)}</span>&nbsp;&nbsp;`
    + `<span style="font-weight:600">${escapeHtml(value)}</span>`
    + "</div>";
}

function mutedLine(value) {
  return `<div style="color:#8e8e93;font-size:11px;margin:5px 0;line-height:1.45">${escapeHtml(value)}</div>`;
}

function escapeHtml(value) {
  return String(value === null || typeof value === "undefined" ? "" : value)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#39;");
}

function errorMessage(error) {
  return error && error.message ? String(error.message) : String(error);
}
