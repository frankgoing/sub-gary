const IP_API = "http://ip-api.com/json?lang=zh-CN";
const CHECK_HOST = "https://check-host.net";
const GP_API = "https://api.globalping.io/v1/measurements";
const TIMEOUT = 8000;

function run() {
  var tag = $environment.params;
  if (!tag) return done("未获取到节点名称");

  $configuration.sendMessage({
    action: "get_server_description",
    content: tag
  }).then(function(resolve) {
    var host = null, port = null;
    if (resolve.ret && resolve.ret[tag]) {
      var desc = resolve.ret[tag];
      var eq = desc.indexOf("=");
      if (eq !== -1) {
        var afterEq = desc.substring(eq + 1);
        var comma = afterEq.indexOf(",");
        var hp = comma === -1 ? afterEq : afterEq.substring(0, comma);
        var colon = hp.lastIndexOf(":");
        var bracket = hp.lastIndexOf("]");
        if (colon !== -1 && bracket < colon) {
          host = hp.substring(0, colon);
          port = hp.substring(colon + 1);
        }
      }
    }
    startChecks(tag, host, port);
  }, function() {
    startChecks(tag, null, null);
  });
}

function startChecks(tag, host, port) {
  var opts = { policy: $environment.params };

  var pA = $task.fetch({ url: IP_API, opts: opts, timeout: TIMEOUT })
    .then(function(r) { return { src: "node", ok: true, data: JSON.parse(r.body) }; })
    .catch(function() { return { src: "node", ok: false }; });

  var pB = $task.fetch({ url: IP_API, timeout: TIMEOUT })
    .then(function(r) { return { src: "direct", ok: true, data: JSON.parse(r.body) }; })
    .catch(function() { return { src: "direct", ok: false }; });

  var pC;
  if (host && port) {
    var target = host + ":" + port;
    var checkUrl = CHECK_HOST + "/check-tcp?host=" + encodeURIComponent(target) + "&max_nodes=10";
    pC = $task.fetch({ url: checkUrl, headers: { "Accept": "application/json" }, timeout: TIMEOUT })
      .then(function(r) {
        var d = JSON.parse(r.body);
        if (!d.ok || !d.request_id) return { src: "remote", ok: false, error: "提交失败" };
        var rid = d.request_id;
        var nodes = d.nodes || {};
        var names = Object.keys(nodes);
        var countryMap = {};
        names.forEach(function(n) {
          var info = nodes[n];
          if (info && info.length >= 1) countryMap[n] = info[0];
        });
        return new Promise(function(resolve) {
          setTimeout(function() {
            $task.fetch({ url: CHECK_HOST + "/check-result/" + rid, headers: { "Accept": "application/json" }, timeout: TIMEOUT })
              .then(function(r2) {
                var res = JSON.parse(r2.body);
                var reachable = false;
                var items = [];
                names.forEach(function(n) {
                  var cc = countryMap[n] || "";
                  var flag = cc ? getFlag(cc) : "\uD83C\uDF0D";
                  if (res[n] && Array.isArray(res[n]) && res[n].length > 0 && res[n][0].time !== undefined) {
                    reachable = true;
                    items.push({ flag: flag, ms: formatMs(res[n][0].time * 1000) });
                  } else {
                    items.push({ flag: flag, ms: "--.--ms" });
                  }
                });
                resolve({ src: "remote", ok: reachable, data: items });
              }, function() {
                resolve({ src: "remote", ok: false, error: "查询失败" });
              });
          }, 3500);
        });
      })
      .catch(function() { return { src: "remote", ok: false, error: "请求失败" }; });
  } else {
    pC = Promise.resolve({ src: "remote", ok: false, error: "无地址信息" });
  }

  Promise.allSettled([pA, pB, pC]).then(function(results) {
    var node = results[0].value;
    var direct = results[1].value;
    var checkHost = results[2].value;

    var nOk = node && node.ok;
    var dOk = direct && direct.ok;
    var cOk = checkHost && checkHost.ok;

    if (dOk && cOk && !nOk && host && port) {
      runGlobalping(tag, host, port, node, direct, checkHost);
    } else {
      render(tag, node, direct, checkHost, null);
    }
  });
}

function runGlobalping(tag, host, port, node, direct, checkHost) {
  var body = {
    type: "ping",
    target: host,
    measurementOptions: { port: parseInt(port), protocol: "TCP" },
    locations: [{ country: "CN", magic: "eyeball-network" }],
    limit: 12
  };

  $task.fetch({
    url: GP_API,
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(body),
    timeout: TIMEOUT
  }).then(function(r) {
    var d = JSON.parse(r.body);
    if (!d.id) { render(tag, node, direct, checkHost, null); return; }

    setTimeout(function() {
      $task.fetch({
        url: GP_API + "/" + d.id,
        headers: { "Accept": "application/json" },
        timeout: TIMEOUT
      }).then(function(r2) {
        render(tag, node, direct, checkHost, JSON.parse(r2.body));
      }, function() {
        render(tag, node, direct, checkHost, null);
      });
    }, 6000);
  }).catch(function() {
    render(tag, node, direct, checkHost, null);
  });
}

function render(tag, node, direct, remote, gpData) {
  var nOk = node && node.ok;
  var dOk = direct && direct.ok;

  // Node
  var nodeHtml = "";
  if (nOk && node.data) {
    var d = node.data;
    var loc = [d.country, d.regionName, d.city].filter(Boolean).join(" - ");
    nodeHtml = '<div style=\"background:#F8FAFC;border-radius:8px;padding:10px;margin-bottom:8px\">'
      + '<div style=\"font-weight:600;font-size:15px;color:#0F172A\">\u2705 \u8282\u70B9\u4EE3\u7406 \u6B63\u5E38</div>'
      + '<div style=\"color:#64748B;font-size:12px;margin-top:3px\">' + esc(d.query) + ' \u00B7 ' + esc(loc) + '</div>'
      + (d.isp ? '<div style=\"color:#94A3B8;font-size:11px;margin-top:2px\">' + esc(d.isp) + '</div>' : "")
      + '</div>';
  } else {
    nodeHtml = '<div style=\"background:#F8FAFC;border-radius:8px;padding:10px;margin-bottom:8px\">'
      + '<div style=\"font-weight:600;color:#EF4444\">\u274C \u8282\u70B9\u4EE3\u7406 \u4E0D\u53EF\u8FBE</div>'
      + '</div>';
  }

  // Direct
  var directHtml = '<div style=\"background:#F8FAFC;border-radius:8px;padding:10px;margin-bottom:8px\">'
    + '<div style=\"font-weight:600;font-size:15px;color:#0F172A\">'
    + (dOk ? "\u2705 \u672C\u673A\u7F51\u7EDC \u6B63\u5E38" : "\u274C \u672C\u673A\u7F51\u7EDC \u5F02\u5E38")
    + '</div>';
  if (dOk && direct.data) {
    directHtml += '<div style=\"color:#64748B;font-size:12px;margin-top:3px\">' + esc(direct.data.query) + ' \u00B7 ' + esc(direct.data.isp || "") + '</div>';
  }
  directHtml += '</div>';

  // Remote check
  var remoteHtml = '<div style=\"background:#F8FAFC;border-radius:8px;padding:10px;margin-bottom:8px\">'
    + '<div style=\"font-weight:600;margin-bottom:4px;color:#0F172A\">\uD83D\uDD0D \u8FDC\u7AEF\u63A2\u6D4B</div>';
  if (remote && remote.ok && remote.data && remote.data.length > 0) {
    for (var i = 0; i < remote.data.length; i += 2) {
      var left = remote.data[i];
      var right = i + 1 < remote.data.length ? remote.data[i + 1] : null;
      remoteHtml += '<div style=\"display:flex;justify-content:space-between;font-size:13px;padding:2px 0\">'
        + '<span>' + left.flag + ' ' + left.ms + '</span>';
      if (right) remoteHtml += '<span>' + right.flag + ' ' + right.ms + '</span>';
      remoteHtml += '</div>';
    }
  } else if (remote && remote.error) {
    remoteHtml += '<div style=\"color:#EF4444;font-size:12px\">\u26A0\uFE0F ' + esc(remote.error) + '</div>';
  } else {
    remoteHtml += '<div style=\"color:#94A3B8;font-size:12px\">-- \u8FDC\u7AEF\u63A2\u6D4B\u672A\u6267\u884C</div>';
  }
  remoteHtml += '</div>';

  // GPS blocking analysis
  var gpHtml = "";
  if (gpData && gpData.results) {
    var analysis = analyzeBlockSource(gpData);
    if (analysis) {
      var ispOrder = ["\u4E2D\u56FD\u7535\u4FE1", "\u4E2D\u56FD\u8054\u901A", "\u4E2D\u56FD\u79FB\u52A8"];
      var ispAbbr = {"\u4E2D\u56FD\u7535\u4FE1": "\u7535\u4FE1", "\u4E2D\u56FD\u8054\u901A": "\u8054\u901A", "\u4E2D\u56FD\u79FB\u52A8": "\u79FB\u52A8"};
      var allProbes = [];
      for (var j = 0; j < ispOrder.length; j++) {
        var key = ispOrder[j];
        var group = analysis.ispGroups[key];
        if (!group) continue;
        for (var p = 0; p < group.probes.length; p++) {
          allProbes.push({
            label: ispAbbr[key] + "\u00B7" + group.probes[p].city,
            ms: group.probes[p].ms,
            ok: group.probes[p].ok
          });
        }
      }

      var domesticReachable = allProbes.some(function(p) { return p.ok; });
      gpHtml = '<div style=\"background:#F8FAFC;border-radius:8px;padding:10px;margin-bottom:8px\">'
        + '<div style=\"font-weight:600;margin-bottom:4px;color:#0F172A\">\uD83C\uDF0D \u56FD\u5185\u63A2\u6D4B</div>'
        + '<div style=\"font-weight:600;font-size:14px;margin-bottom:6px\">'
        + (domesticReachable ? "\u2705 \u53EF\u8FBE" : "\u274C \u4E0D\u53EF\u8FBE")
        + '</div>';
      for (var i2 = 0; i2 < allProbes.length; i2 += 2) {
        var l = allProbes[i2];
        var r = i2 + 1 < allProbes.length ? allProbes[i2 + 1] : null;
        var lc = l.ok ? "#10B981" : "#EF4444";
        gpHtml += '<div style=\"display:flex;justify-content:space-between;font-size:12px;padding:2px 0\">'
          + '<span>' + esc(l.label) + '</span>'
          + '<span style=\"font-family:Menlo,monospace;color:' + lc + '\">' + l.ms + '</span>';
        if (r) {
          var rc = r.ok ? "#10B981" : "#EF4444";
          gpHtml += '<span>' + esc(r.label) + '</span>'
            + '<span style=\"font-family:Menlo,monospace;color:' + rc + '\">' + r.ms + '</span>';
        }
        gpHtml += '</div>';
      }
      gpHtml += '<div style=\"margin-top:6px;font-size:13px;font-weight:600;color:#0F172A\">' + esc(analysis.conclusion) + '</div>';
      gpHtml += '</div>';
    }
  }

  // Conclusion
  var conclusion = "", conclusionColor = "#64748B";
  if (!dOk) {
    conclusion = "\u26A0\uFE0F \u672C\u673A\u7F51\u7EDC\u5F02\u5E38\uFF0C\u8BF7\u68C0\u67E5\u7F51\u7EDC\u8FDE\u63A5";
    conclusionColor = "#EF4444";
  } else if (nOk) {
    conclusion = "\u2705 \u8282\u70B9\u6B63\u5E38\uFF0C\u53EF\u6B63\u5E38\u8FDE\u63A5";
    conclusionColor = "#10B981";
  } else if (!nOk && dOk && remote && remote.ok) {
    conclusion = "\u26A0\uFE0F \u8282\u70B9\u65E0\u6CD5\u8FDE\u63A5\uFF0C\u4F46\u5916\u7F51\u53EF\u8FBE \u2014 \u53EF\u80FD\u88AB\u963B\u65AD";
    conclusionColor = "#F59E0B";
  } else if (!nOk && dOk && gpData && gpData.results) {
    var a2 = analyzeBlockSource(gpData);
    if (a2) {
      conclusion = a2.conclusion;
      conclusionColor = a2.conclusion.indexOf("\u274C") === 0 ? "#EF4444" : "#F59E0B";
    }
  } else {
    conclusion = "\u274C \u8282\u70B9\u79BB\u7EBF\u6216\u88AB\u963B\u65AD";
    conclusionColor = "#EF4444";
  }

  var html = '<div style=\"font-family:-apple-system,BlinkMacSystemFont;font-size:14px;line-height:1.5;padding:4px 0\">'
    + '<div style=\"font-size:18px;font-weight:700;color:#0F172A;margin-bottom:4px\">\uD83C\uDF10 \u8282\u70B9\u963B\u65AD\u68C0\u6D4B</div>'
    + '<div style=\"color:#94A3B8;font-size:11px;margin-bottom:10px\">\u8282\u70B9 \u00B7 ' + esc(tag) + '</div>'
    + nodeHtml + directHtml + remoteHtml + gpHtml
    + '<div style=\"background:#F8FAFC;border-radius:8px;padding:10px\">'
    + '<div style=\"font-weight:600;font-size:14px;color:#0F172A;margin-bottom:4px\">\uD83D\uDCCB \u8BCA\u65AD\u7ED3\u8BBA</div>'
    + '<div style=\"font-weight:600;font-size:14px;color:' + conclusionColor + '\">' + conclusion + '</div>'
    + '</div></div>';

  $done({
    title: "\u8282\u70B9\u963B\u65AD\u68C0\u6D4B",
    htmlMessage: html
  });
}

function done(msg) {
  $done({
    title: "\u8282\u70B9\u963B\u65AD\u68C0\u6D4B",
    htmlMessage: '<div style=\"font-family:-apple-system,BlinkMacSystemFont;font-size:14px;padding:12px 0\"><span style=\"font-weight:600;color:#EF4444\">\u26A0\uFE0F ' + esc(msg) + '</span></div>'
  });
}

function getFlag(cc) {
  if (!cc || cc.length !== 2) return "\uD83C\uDF0D";
  var cp = cc.toUpperCase().split("").map(function(c) { return 127397 + c.charCodeAt(); });
  return String.fromCodePoint.apply(null, cp);
}

function formatMs(ms) {
  if (ms <= 0) return "0.00ms";
  if (ms >= 10000) return Math.floor(ms) + "ms";
  if (ms >= 1000) return Math.floor(ms).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",") + "ms";
  if (ms >= 100) return ms.toFixed(1) + "ms";
  if (ms >= 10) return ms.toFixed(2) + "ms";
  return ms.toFixed(3) + "ms";
}

function esc(s) {
  return String(s == null ? "" : s)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#39;");
}

run();