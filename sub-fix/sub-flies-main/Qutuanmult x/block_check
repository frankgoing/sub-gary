/**
 * 节点连通性检测 · Quantumult X event-interaction 脚本
 * 检测节点是否被运营商/GFW 阻断
 *
 * [task_local]
 * event-interaction https://raw.githubusercontent.com/frankgoing/sub-gary/refs/heads/main/sub-fix/sub-flies-main/Qutuanmult%20x/block_check, tag=节点阻断检测, img-url=bolt.horizontal.icloud.fill.system, enabled=true
 */

const IP_API = "http://ip-api.com/json?lang=zh-CN";
const CHECK_HOST = "https://check-host.net";
const GP_API = "https://api.globalping.io/v1/measurements";
const TIMEOUT = 8000;

function run() {
  var tag = $environment.params;
  if (!tag) return fail("未获取到节点名称");

  $configuration.sendMessage({
    action: "get_server_description",
    content: tag
  }).then(function(resolve) {
    var host = null, port = null;
    if (resolve.ret && resolve.ret[tag]) {
      var desc = resolve.ret[tag];
      var eq = desc.indexOf("=");
      if (eq !== -1) {
        var afterEq = desc.substring(eq + 1);
        var comma = afterEq.indexOf(",");
        var str = comma === -1 ? afterEq : afterEq.substring(0, comma);
        // 正确处理 IPv6: 最后一个:在]之后才认作端口分隔符
        var colon = str.lastIndexOf(":");
        var bracket = str.lastIndexOf("]");
        if (colon !== -1 && bracket < colon) {
          host = str.substring(0, colon);
          port = str.substring(colon + 1);
        } else {
          host = str;
        }
      }
    }
    start(tag, host, port);
  }, function() {
    start(tag, null, null);
  });
}

function start(tag, host, port) {
  var viaNode = $task.fetch({ url: IP_API, opts: { policy: $environment.params }, timeout: TIMEOUT })
    .then(function(r) { return { ok: true, data: JSON.parse(r.body) }; })
    .catch(function() { return { ok: false, data: null }; });

  var viaDirect = $task.fetch({ url: IP_API, timeout: TIMEOUT })
    .then(function(r) { return { ok: true, data: JSON.parse(r.body) }; })
    .catch(function() { return { ok: false, data: null }; });

  var viaRemote;
  if (host && port) {
    var target = host + ":" + port;
    var checkUrl = CHECK_HOST + "/check-tcp?host=" + encodeURIComponent(target) + "&max_nodes=8";
    viaRemote = $task.fetch({ url: checkUrl, headers: { "Accept": "application/json" }, timeout: TIMEOUT })
      .then(function(r) {
        var d = JSON.parse(r.body);
        if (!d.ok || !d.request_id) return { ok: false, data: null, error: "提交失败" };
        var rid = d.request_id;
        var nodes = d.nodes || {};
        var names = Object.keys(nodes);
        var countryMap = {};
        names.forEach(function(n) {
          var info = nodes[n];
          if (info && info.length >= 1) countryMap[n] = info[0];
        });
        return new Promise(function(resolve) {
          setTimeout(function() {
            $task.fetch({ url: CHECK_HOST + "/check-result/" + rid, headers: { "Accept": "application/json" }, timeout: TIMEOUT })
              .then(function(r2) {
                var res = JSON.parse(r2.body);
                var reachable = false;
                var items = [];
                names.forEach(function(n) {
                  var cc = countryMap[n] || "";
                  var flag = cc ? getFlag(cc) : String.fromCodePoint(127758);
                  var nr = res[n];
                  var ms = "--.--ms";
                  if (nr && Array.isArray(nr) && nr.length > 0 && nr[0].time !== undefined) {
                    reachable = true;
                    ms = fmt(nr[0].time * 1000);
                  }
                  items.push({ flag: flag, ms: ms });
                });
                resolve({ ok: reachable, data: items });
              }, function() {
                resolve({ ok: false, data: null, error: "查询失败" });
              });
          }, 3500);
        });
      })
      .catch(function() { return { ok: false, data: null, error: "请求失败" }; });
  } else {
    viaRemote = Promise.resolve({ ok: false, data: null, error: "无地址信息" });
  }

  Promise.all([viaNode, viaDirect, viaRemote]).then(function(results) {
    render(tag, results[0], results[1], results[2]);
  });
}

function render(tag, node, direct, remote) {
  var nOk = node && node.ok;
  var dOk = direct && direct.ok;

  // 节点信息
  var nodeStr = "";
  if (nOk && node.data) {
    var d = node.data;
    var loc = [d.country, d.regionName, d.city].filter(Boolean).join(" - ");
    nodeStr = '<div style="background:#F8FAFC;border-radius:8px;padding:10px;margin-bottom:8px">'
      + '<div style="font-weight:600;font-size:15px;color:#0F172A">'
      + (nOk ? "\u2705 \u8282\u70B9\u4EE3\u7406 \u6B63\u5E38" : "\u274C \u8282\u70B9\u4EE3\u7406 \u4E0D\u53EF\u8FBE")
      + '</div>'
      + '<div style="color:#64748B;font-size:12px;margin-top:3px">' + esc(d.query) + ' \u00B7 ' + esc(loc) + '</div>'
      + (d.isp ? '<div style="color:#94A3B8;font-size:11px;margin-top:1px">' + esc(d.isp) + '</div>' : "")
      + '</div>';
  } else {
    nodeStr = '<div style="background:#F8FAFC;border-radius:8px;padding:10px;margin-bottom:8px">'
      + '<div style="font-weight:600;color:#EF4444">\u274C \u8282\u70B9\u4EE3\u7406 \u4E0D\u53EF\u8FBE</div>'
      + '</div>';
  }

  // 本机信息
  var directStr = '<div style="background:#F8FAFC;border-radius:8px;padding:10px;margin-bottom:8px">'
    + '<div style="font-weight:600;font-size:15px;color:#0F172A">'
    + (dOk ? "\u2705 \u672C\u673A\u7F51\u7EDC \u6B63\u5E38" : "\u274C \u672C\u673A\u7F51\u7EDC \u5F02\u5E38")
    + '</div>'
    + (dOk && direct.data
      ? '<div style="color:#64748B;font-size:12px;margin-top:3px">' + esc(direct.data.query) + ' \u00B7 ' + esc(direct.data.isp || "") + '</div>'
      : '<div style="color:#EF4444;font-size:12px;margin-top:3px">\u65E0\u6CD5\u8BBF\u95EE ip-api.com</div>')
    + '</div>';

  // 远端探测
  var remoteStr = '<div style="background:#F8FAFC;border-radius:8px;padding:10px;margin-bottom:8px">'
    + '<div style="font-weight:600;font-size:15px;color:#0F172A;margin-bottom:6px">\uD83D\uDD0D \u8FDC\u7AEF\u63A2\u6D4B</div>';
  if (remote && remote.ok && remote.data && remote.data.length > 0) {
    remoteStr += '<div style="font-size:12px;line-height:1.6">';
    for (var i = 0; i < remote.data.length; i += 2) {
      var left = remote.data[i];
      var right = i + 1 < remote.data.length ? remote.data[i + 1] : null;
      remoteStr += '<div style="display:flex;justify-content:space-between;padding:1px 0">'
        + '<span>' + left.flag + " " + left.ms + '</span>';
      if (right) remoteStr += '<span>' + right.flag + " " + right.ms + '</span>';
      remoteStr += '</div>';
    }
    remoteStr += '</div>';
  } else if (remote && remote.error) {
    remoteStr += '<div style="color:#EF4444;font-size:12px">\u26A0\uFE0F ' + esc(remote.error) + '</div>';
  } else {
    remoteStr += '<div style="color:#94A3B8;font-size:12px">\u2014 \u8FDC\u7AEF\u63A2\u6D4B\u672A\u6267\u884C</div>';
  }
  remoteStr += '</div>';

  // 结论
  var conclusion = "", conclusionColor = "#64748B";
  if (!dOk) {
    conclusion = "\u26A0\uFE0F \u672C\u673A\u7F51\u7EDC\u5F02\u5E38\uFF0C\u8BF7\u68C0\u67E5\u7F51\u7EDC\u8FDE\u63A5";
    conclusionColor = "#EF4444";
  } else if (nOk) {
    conclusion = "\u2705 \u8282\u70B9\u6B63\u5E38\uFF0C\u53EF\u6B63\u5E38\u8FDE\u63A5";
    conclusionColor = "#10B981";
  } else if (!nOk && dOk && remote && remote.ok) {
    conclusion = "\u26A0\uFE0F \u8282\u70B9\u65E0\u6CD5\u8FDE\u63A5\uFF0C\u4F46\u5916\u7F51\u53EF\u8FBE \u2014 \u53EF\u80FD\u88AB\u963B\u65AD";
    conclusionColor = "#F59E0B";
  } else if (!nOk && dOk && remote && !remote.ok && remote.data) {
    conclusion = "\u274C \u8282\u70B9\u79BB\u7EBF\u6216\u88AB\u963B\u65AD";
    conclusionColor = "#EF4444";
  } else {
    conclusion = "\u2753 \u6570\u636E\u4E0D\u5B8C\u6574";
  }

  var html = '<div style="font-family:-apple-system,BlinkMacSystemFont;font-size:14px;line-height:1.5;padding:4px 0">'
    + '<div style="font-size:18px;font-weight:700;color:#0F172A;margin-bottom:4px">\uD83C\uDF10 \u8282\u70B9\u963B\u65AD\u68C0\u6D4B</div>'
    + '<div style="color:#94A3B8;font-size:11px;margin-bottom:10px">\u8282\u70B9 \u00B7 ' + esc(tag) + '</div>'
    + nodeStr + directStr + remoteStr
    + '<div style="background:#F8FAFC;border-radius:8px;padding:10px">'
    + '<div style="font-weight:600;font-size:14px;color:#0F172A;margin-bottom:4px">\uD83D\uDCCB \u8BCA\u65AD\u7ED3\u8BBA</div>'
    + '<div style="font-weight:600;font-size:14px;color:' + conclusionColor + '">' + conclusion + '</div>'
    + '</div>'
    + '</div>';

  $done({
    title: "\u8282\u70B9\u963B\u65AD\u68C0\u6D4B",
    htmlMessage: html
  });
}

function fail(msg) {
  $done({
    title: "\u8282\u70B9\u963B\u65AD\u68C0\u6D4B",
    htmlMessage: '<div style="font-family:-apple-system,BlinkMacSystemFont;font-size:14px;padding:12px;color:#EF4444">\u26A0\uFE0F ' + esc(msg) + '</div>'
  });
}

function getFlag(cc) {
  if (!cc || cc.length !== 2) return String.fromCodePoint(127758);
  return String.fromCodePoint(127397 + cc.charCodeAt(0), 127397 + cc.charCodeAt(1));
}

function fmt(ms) {
  if (ms <= 0) return "0.00ms";
  if (ms >= 10000) return Math.floor(ms) + "ms";
  if (ms >= 1000) return Math.floor(ms).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",") + "ms";
  if (ms >= 100) return ms.toFixed(1) + "ms";
  if (ms >= 10) return ms.toFixed(2) + "ms";
  return ms.toFixed(3) + "ms";
}

function esc(s) {
  return String(s == null ? "" : s)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#39;");
}

run();
