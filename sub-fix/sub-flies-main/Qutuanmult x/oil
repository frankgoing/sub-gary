async function run() {
  // mxnzp 普通账号 QPS=1（每秒 1 次）：各省串行请求，避免并发触发限流
  const results = [];
  for (let i = 0; i < provinces.length; i += 1) {
    results.push(await fetchProvince(provinces[i]));
  }
  render(results);
}

async function fetchProvince(prov) {
  // 1) mxnzp（免费 1000次/天，含 98#）——优先
  const mxnzp = await fetchMxnzp(prov);
  if (mxnzp) return { prov, ok: true, data: mxnzp };
  // 2) 天行数据多 key 轮换
  const encodedProv = encodeURIComponent(prov);
  let lastError = "";
  for (let i = 0; i < API_KEYS.length; i += 1) {
    const url = `https://apis.tianapi.com/oilprice/index?key=${API_KEYS[i]}&prov=${encodedProv}`;
    try {
      const body = await request(url);
      const obj = JSON.parse(body);
      console.log(obj);
      if (obj.code === 200 && obj.result) {
        return { prov, ok: true, data: obj.result };
      }
      lastError = obj.msg || `code ${obj.code}`;
      console.log(`[WARN] ${prov} 第 ${i + 1} 个 key 返回失败: ${lastError}`);
    } catch (error) {
      lastError = errorMessage(error);
      console.log(`[WARN] ${prov} 第 ${i + 1} 个 key 请求失败: ${lastError}`);
    }
  }
  // 3) 天行数据全部失败 → 小熊油耗网页抓取兜底（免 key 无限量）
  console.log(`[WARN] ${prov} 天行数据全部失败，切换小熊油耗抓取`);
  const fallback = await fetchXiaoxiong(prov);
  if (fallback) return { prov, ok: true, data: fallback };
  return { prov, ok: false, error: lastError || "全部 key 均请求失败" };
}

// mxnzp.com 免费油价 API：返回字段 t92/t95/t98/t0（含 98#）
// 普通账号 QPS=1：遇限流自动等待 1.1s 重试一次
async function fetchMxnzp(prov) {
  for (let attempt = 1; attempt <= 2; attempt += 1) {
    try {
      const url = `https://www.mxnzp.com/api/oil/search?province=${encodeURIComponent(prov)}&app_id=${MXNZP_APP_ID}&app_secret=${MXNZP_APP_SECRET}`;
      const body = await request(url);
      const obj = JSON.parse(body);
      if (obj.code === 1 && obj.data) {
        const d = obj.data;
        return {
          prov: d.province || prov,
          p92: d.t92,
          p95: d.t95,
          p98: d.t98,
          p0: d.t0,
          time: d.updateTime || d.time || "",
        };
      }
      if (/频率过快|QPS/i.test(obj.msg || "")) {
        if (attempt < 2) {
          console.log(`[WARN] ${prov} mxnzp QPS 限流，等待 1.1s 重试`);
          await sleep(1100);
          continue;
        }
        console.log(`[WARN] ${prov} mxnzp 重试仍限流，降级下一源`);
        return null;
      }
      console.log(`[WARN] ${prov} mxnzp 返回失败: ${obj.msg || `code ${obj.code}`}`);
      return null;
    } catch (error) {
      console.log(`[WARN] ${prov} mxnzp 请求失败: ${errorMessage(error)}`);
      return null;
    }
  }
  return null;
}

function sleep(ms) {
  return new Promise((resolve) => setTimeout(resolve, ms));
}

// 小熊油耗（xiaoxiongyouhao.com/fprice/）免 key 兜底源：表格列 92#/95#/0#柴（无 98#）
async function fetchXiaoxiong(prov) {
  const UA = "Mozilla/5.0 (iPhone; CPU iPhone OS 18_0 like Mac OS X) AppleWebKit/605.1.15";
  try {
    const body = await request("https://www.xiaoxiongyouhao.com/fprice/", {
      "User-Agent": UA,
      Accept: "text/html,application/xhtml+xml,application/json;q=0.9,*/*;q=0.8",
    });
    const pattern = /<td class="region-name">[\s\S]*?>([^<]{2,20}?)<\/a><\/td>\s*<td[^>]*>(\d+\.\d{2})<\/td>\s*<td[^>]*>(\d+\.\d{2})<\/td>\s*<td[^>]*>(\d+\.\d{2})<\/td>/g;
    let match;
    while ((match = pattern.exec(body)) !== null) {
      const name = String(match[1]).replace(/省$/, "");
      if (prov === name || name.indexOf(prov) !== -1 || prov.indexOf(name) !== -1) {
        const timeMatch = body.match(/上次调价[：:]\s*([\d-]+)/);
        return {
          prov: String(match[1]),
          p92: match[2],
          p95: match[3],
          p0: match[4],
          time: timeMatch ? timeMatch[1] : "小熊油耗",
        };
      }
    }
    return null;
  } catch (error) {
    console.log(`[WARN] 小熊油耗抓取失败: ${errorMessage(error)}`);
    return null;
  }
}

function request(url, headers) {
  return new Promise((resolve, reject) => {
    if (typeof $httpClient !== "undefined") {
      $httpClient.get({ url, headers }, (error, response, data) => {
        if (error) reject(new Error(error));
        else resolve(data);
      });
    } else if (typeof $task !== "undefined") {
      $task.fetch({ url, headers }).then(
        (response) => resolve(response.body),
        (error) => reject(new Error(errorMessage(error && error.error ? error.error : error)))
      );
    } else {
      reject(new Error("Unsupported execution environment"));
    }
  });
}

// 2026 年油价调整日历（调整时间为当日 24 时）
const ADJUST_CALENDAR = [
  [ 1,  6, "不作调整"],
  [ 1, 20, "上调"],
  [ 2,  3, "上调"],
  [ 2, 24, "上调"],
  [ 3,  9, "上调"],
  [ 3, 23, "上调"],
  [ 4,  7, "上调"],
  [ 4, 21, "下调"],
  [ 5,  8, "上调"],
  [ 5, 21, "上调"],
  [ 6,  4, "下调"],
  [ 6, 18, "下调"],
  [ 7,  3, "下调"],
  [ 7, 17, "上调"],
  [ 7, 31, "上调"],
  [ 8, 14, "待公布"],
  [ 8, 28, "待公布"],
  [ 9, 11, "待公布"],
  [ 9, 24, "待公布"],
  [10, 15, "待公布"],
  [10, 29, "待公布"],
  [11, 12, "待公布"],
  [11, 26, "待公布"],
  [12, 10, "待公布"],
  [12, 24, "待公布"],
];

function getAdjustInfo() {
  const now = new Date();
  const curYear = now.getFullYear();
  const curMonth = now.getMonth() + 1;
  const curDay = now.getDate();
  const curTs = now.getTime();

  let last = null;
  let next = null;

  for (const [m, d, status] of ADJUST_CALENDAR) {
    // 构造该调价日的 Date 对象（默认当日 24 时 = 次日 0 时）
    const date = new Date(curYear, m - 1, d + 1); // +1 天 = 当日 24 时
    const ts = date.getTime();

    if (ts <= curTs) {
      last = { month: m, day: d, status };
    } else if (!next) {
      next = { month: m, day: d, status };
      break;
    }
  }

  // 跨年：如果当前日期在年内最早调价日之前，上一年最后一次调价为最近一次
  if (!last && ADJUST_CALENDAR.length) {
    const lastEntry = ADJUST_CALENDAR[ADJUST_CALENDAR.length - 1];
    last = { month: lastEntry[0], day: lastEntry[1], status: lastEntry[2] };
  }

  return { last, next };
}

const FUEL_META = [
  ["92号汽油", "⛽", "#10B981", "p92"],
  ["95号汽油", "⛽", "#F59E0B", "p95"],
  ["98号汽油", "⛽", "#EF4444", "p98"],
  ["0号柴油", "🛢", "#6366F1", "p0"],
];

function render(results) {
  const okResults = results.filter((result) => result.ok);
  const displayTime = okResults.length ? String(okResults[0].data.time || "") : "";
  const failCount = results.length - okResults.length;
  const adj = getAdjustInfo();

  const adjColor = (s) => {
    if (s === "上调") return "#EF4444";
    if (s === "下调") return "#10B981";
    return "#94A3B8";
  };

  const html = [
    '<div style="font-family:-apple-system,BlinkMacSystemFont;font-size:14px;line-height:1.5;text-align:left;overflow-wrap:anywhere;padding:16px">',

    // 调价时间
    adj.last
      ? `<div style="font-size:12px;color:#64748B;margin-bottom:3px">上次调价 <span style="font-weight:600;color:${adjColor(adj.last.status)}">${adj.last.month}月${adj.last.day}日 ${adj.last.status}</span></div>`
      : "",
    adj.next
      ? `<div style="font-size:12px;color:#64748B;margin-bottom:10px">下次调价 <span style="font-weight:600;color:${adjColor(adj.next.status)}">${adj.next.month}月${adj.next.day}日 ${adj.next.status}</span></div>`
      : '<div style="margin-bottom:10px"></div>',

    displayTime
      ? `<div style="color:#94A3B8;font-size:11px;margin-bottom:12px">数据更新 ${escapeHtml(displayTime)}</div>`
      : "",

    // 各省卡片
    results.map((result) => renderProvinceCard(result)).join(""),

    // 底部
    '<div style="margin-top:12px;padding-top:10px;border-top:1px solid #E2E8F0">',
    '<div style="color:#94A3B8;font-size:10px;line-height:1.5">',
    failCount > 0
      ? `⚠️ ${failCount} 个省数据获取失败 · `
      : "",
    '数据源：mxnzp → 天行数据 → 小熊油耗（自动降级）',
    '</div>',
    '</div>',

    "</div>",
  ].join("");

  $done({
    title: "油价查询",
    htmlMessage: html,
  });
}

function renderProvinceCard(result) {
  if (!result.ok) {
    return [
      '<div style="padding:8px 0;margin-bottom:4px">',
      `<div style="font-size:15px;font-weight:700;color:#0F172A;margin-bottom:6px">📍 ${escapeHtml(result.prov)}</div>`,
      `<div style="color:#EF4444;font-size:12px">⚠️ ${escapeHtml(result.error)}</div>`,
      '</div>',
    ].join("");
  }

  const data = result.data;
  const provName = data.prov || result.prov;

  const fuelLines = FUEL_META
    .filter(([, , , key]) => data[key] !== undefined && data[key] !== null && data[key] !== "")
    .map(([label, icon, color, key]) => {
      return '<div style="padding:10px 0;border-bottom:1px solid #F1F5F9;white-space:nowrap;overflow:hidden">'
        + `<span style="font-size:13px;display:inline-block;width:26px">${icon}</span>`
        + `<span style="font-size:13px;font-weight:500;color:#334155;display:inline-block;width:80px">${escapeHtml(label)}</span>`
        + `<span style="font-size:13px;font-weight:700;color:${color};margin-left:12px">¥${escapeHtml(data[key])}</span>`
        + '</div>';
    })
    .join("");

  return [
    '<div style="padding:8px 0;margin-bottom:4px">',
    `<div style="font-size:15px;font-weight:700;color:#0F172A;margin-bottom:8px">📍 ${escapeHtml(provName)}</div>`,
    fuelLines,
    '</div>',
  ].join("");
}

function escapeHtml(value) {
  return String(value === null || typeof value === "undefined" ? "" : value)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#39;");
}

function errorMessage(error) {
  return error && error.message ? String(error.message) : String(error);
}
